# Server Configuration
NODE_ENV=development
PORT=3001
# Note: Port 5000 is often used by macOS AirPlay Receiver
# If you want to use port 5000, disable AirPlay Receiver in System Settings

# MongoDB Configuration
# For Docker Compose (default - no auth for simplicity):
MONGO_URI=mongodb://mongodb:27017/missionconnect
# For Docker Compose with authentication:
# MONGO_URI=mongodb://admin:password@mongodb:27017/missionconnect?authSource=admin
# For local development without Docker:
# MONGO_URI=mongodb://localhost:27017/missionconnect

# MongoDB Database Name
MONGO_DATABASE=missionconnect

# Optional: MongoDB Authentication (uncomment to enable)
# MONGO_ROOT_USERNAME=admin
# MONGO_ROOT_PASSWORD=password
# Then update MONGO_URI to: mongodb://admin:password@mongodb:27017/missionconnect?authSource=admin

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production

# CORS Configuration (optional)
# For production, specify allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Leave empty or set to '*' to allow all origins (development only)
ALLOWED_ORIGINS=*

