# Development Dockerfile with nodemon for hot reloading
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy application files
COPY . .

# Expose port
EXPOSE 3001

# Start the application with nodemon for development
CMD ["npm", "run", "dev"]

